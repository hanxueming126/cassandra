            </build>
        </profile>

        <!-- Profile to create final release artifacts (tar.gz files) -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>make-bin-tar-gz</id>
                                <phase>package</phase>
                                <goals><goal>single</goal></goals>
                                <configuration>
                                    <finalName>${project.build.finalName}-bin</finalName>
                                    <appendAssemblyId>false</appendAssemblyId>
                                    <descriptors>
                                        <!-- You need to create this assembly descriptor -->
                                        <descriptor>.build/assemblies/bin-assembly.xml</descriptor>
                                    </descriptors>
                                </configuration>
                            </execution>
                            <execution>
                                <id>make-src-tar-gz</id>
                                <phase>package</phase>
                                <goals><goal>single</goal></goals>
                                <configuration>
                                    <finalName>${project.build.finalName}-src</finalName>
                                    <appendAssemblyId>false</appendAssemblyId>
                                    <descriptors>
                                        <!-- You need to create this assembly descriptor -->
                                        <descriptor>.build/assemblies/src-assembly.xml</descriptor>
                                    </descriptors>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- For a real release, you would add maven-gpg-plugin here -->
                </plugins>
            </build>
        </profile>
    </profiles>
